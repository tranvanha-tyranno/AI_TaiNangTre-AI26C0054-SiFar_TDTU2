{
  "schema_version": 1,
  "views": [
    "CREATE VIEW canonical_events AS SELECT event,shipment,at,status,revision,ingested FROM (SELECT *,row_number() OVER(PARTITION BY event ORDER BY revision DESC,ingested DESC) rn FROM events) WHERE rn=1",
    "CREATE VIEW final_events AS SELECT event,shipment,at,status FROM (SELECT *,row_number() OVER(PARTITION BY shipment ORDER BY at DESC,event DESC) rn FROM canonical_events) WHERE rn=1",
    "CREATE VIEW delivery AS SELECT s.*,d.region,f.status,f.at AS final_at,(strftime('%s',f.at)-strftime('%s',s.created))/3600 AS elapsed_hours,CASE WHEN f.status='Đã giao' AND f.at<=s.due THEN 1 ELSE 0 END AS on_time FROM shipments s JOIN depots d USING(depot) JOIN final_events f USING(shipment)"
  ],
