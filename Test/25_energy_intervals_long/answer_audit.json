    "CREATE VIEW valid_energy AS SELECT r.*,p.region,p.carbon,t.tariff,import_kwh-export_kwh net_kwh,(import_kwh-export_kwh)*t.tariff net_cost FROM readings r JOIN plants p USING(plant) JOIN tariffs t ON r.plant=t.plant AND r.at>=t.start AND r.at<t.end WHERE r.quality='Đo thật' AND r.import_kwh IS NOT NULL",
